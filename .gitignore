# mCatcher repository — track ONLY the Media Catcher extension + host.
# The workspace (C:\Code) holds other projects too, so ignore everything at the
# root by default, then re-include the two Media Catcher projects.
/*
!/.gitignore
!/README.md
!/.github
!/media-catcher
!/media-catcher-host
!/docs
!/devtools

# --- exclusions inside the tracked projects ---

# Large binaries: the installer downloads ffmpeg + yt-dlp at install time.
media-catcher-host/ffmpeg.exe
media-catcher-host/ffprobe.exe
media-catcher-host/yt-dlp.exe
media-catcher-host/deno.exe
media-catcher-host/node/
media-catcher-host/pot-provider/
media-catcher-host/pylibs/
media-catcher-host/pylib/

# Build artifacts.
media-catcher-host/installer/dist/

# Machine-specific / installer-generated files (paths, user settings).
media-catcher-host/mc_config.json
media-catcher-host/com.mediacatcher.host.json
media-catcher-host/mc_host.bat
media-catcher-host/cast_creds_*.json
# update_staging_dir() creates this inside the tracked tree; a staged release
# zip is a downloaded artifact, not source.
media-catcher-host/updates/
# mchost/written.py's ledger of files this host wrote — per-machine runtime
# state in the same directory, for the same reason.
media-catcher-host/written-files.jsonl

# Agent scratch. The root one is already covered by the /* rule above, but a
# nested copy (made by running a command from the wrong directory) is not, and
# would be swept into a commit by `git add -A`.
**/.superpowers/

# Caches and cruft.
**/__pycache__/
*.pyc
**/node_modules/
*.log
.DS_Store
Thumbs.db
